# Copy to .env and fill in. Never commit .env.

# Database password (any long random string): openssl rand -base64 24
POSTGRES_PASSWORD=

# Master key that encrypts stored credentials. 32 random bytes, base64:
#   openssl rand -base64 32
# Back it up somewhere safe: without it, stored API tokens cannot be decrypted.
FSM_MASTER_KEY=

# First administrator, created only when no users exist. Remove the password
# from this file after the first start and change it in the dashboard.
FSM_INITIAL_ADMIN_USERNAME=admin
FSM_INITIAL_ADMIN_PASSWORD=

# Hosts the controller may contact (comma separated, *.suffix allowed).
# List your Proxmox, NPM and application hosts plus api.cloudflare.com.
FSM_EGRESS_ALLOWLIST=api.cloudflare.com,10.0.0.10,10.1.0.10

# Run health checks on a schedule (set false to start with monitoring off).
FSM_ENGINE_ENABLED=true

FSM_SESSION_TTL_HOURS=12
FSM_SESSION_IDLE_MINUTES=30
FSM_RESULT_RETENTION_DAYS=14
LOG_LEVEL=info

# Published ports for the dashboard
FSM_HTTPS_PORT=443
FSM_HTTP_PORT=80
